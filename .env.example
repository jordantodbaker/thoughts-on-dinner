# Postgres connection string. Two options:
#
#   1. Zero setup (local dev only): an in-process Postgres with the schema and
#      seed data loaded automatically on first request.
#        DATABASE_URL="pglite://memory"          # wiped on restart
#        DATABASE_URL="pglite://./.pglite"       # persisted in ./.pglite
#
#   2. A real database (Neon, Prisma Postgres, Supabase, RDS, local...). This is
#      what Vercel needs: set it in Project Settings > Environment Variables,
#      then run `pnpm db:deploy` and `pnpm db:seed` once against it.
#        DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL="pglite://memory"

# Anthropic API key for the weekly AI scout that refreshes deals/events.
# Leave unset to run on seed data only (the admin page says so).
ANTHROPIC_API_KEY=""

# Shared secret for the cron/admin refresh endpoints. Vercel Cron sends it
# automatically as `Authorization: Bearer <CRON_SECRET>` when the variable is
# set on the project. Any random string works: `openssl rand -hex 32`.
CRON_SECRET=""
